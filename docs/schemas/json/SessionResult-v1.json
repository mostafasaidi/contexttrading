{
  "engine_version": "0.1.0",
  "json_schema": {
    "$defs": {
      "LineStyle": {
        "description": "Stroke styles understood by both Plotly and Lightweight Charts.",
        "enum": [
          "solid",
          "dashed",
          "dotted"
        ],
        "title": "LineStyle",
        "type": "string"
      },
      "LiquidityPool": {
        "additionalProperties": false,
        "description": "Resting liquidity above highs / below lows.",
        "properties": {
          "formed_at_index": {
            "description": "Candle index where the pool became known.",
            "minimum": 0,
            "title": "Formed At Index",
            "type": "integer"
          },
          "id": {
            "default": "",
            "description": "Deterministic content-hash ID.",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/$defs/LiquidityPoolKind",
            "description": "Formation creating the pool."
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional human-facing label.",
            "title": "Label"
          },
          "layer": {
            "default": "default",
            "description": "Render/grouping layer.",
            "title": "Layer",
            "type": "string"
          },
          "pool_class": {
            "$ref": "#/$defs/SwingClass",
            "description": "INTERNAL or EXTERNAL liquidity."
          },
          "price": {
            "description": "Level where liquidity rests.",
            "exclusiveMinimum": 0,
            "title": "Price",
            "type": "number"
          },
          "priority": {
            "default": 0,
            "description": "Render/selection priority (higher wins).",
            "title": "Priority",
            "type": "integer"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          },
          "side": {
            "$ref": "#/$defs/LiquiditySide"
          },
          "source_ids": {
            "description": "Swing/equal-level IDs backing this pool.",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Source Ids",
            "type": "array"
          },
          "status": {
            "$ref": "#/$defs/PoolStatus",
            "default": "untapped"
          },
          "style": {
            "$ref": "#/$defs/VisualStyle"
          }
        },
        "required": [
          "price",
          "side",
          "kind",
          "pool_class",
          "source_ids",
          "formed_at_index"
        ],
        "title": "LiquidityPool",
        "type": "object"
      },
      "LiquidityPoolKind": {
        "description": "Formation that creates a liquidity pool.",
        "enum": [
          "equal_highs",
          "equal_lows",
          "swing_high",
          "swing_low",
          "session_high",
          "session_low",
          "previous_day_high",
          "previous_day_low"
        ],
        "title": "LiquidityPoolKind",
        "type": "string"
      },
      "LiquiditySide": {
        "description": "Side of the book where resting liquidity sits.",
        "enum": [
          "buyside",
          "sellside"
        ],
        "title": "LiquiditySide",
        "type": "string"
      },
      "LiquiditySweep": {
        "additionalProperties": false,
        "description": "A stop-run event against a liquidity pool.",
        "properties": {
          "candle_index": {
            "description": "Index of the sweeping candle.",
            "minimum": 0,
            "title": "Candle Index",
            "type": "integer"
          },
          "classification": {
            "$ref": "#/$defs/SweepClassification"
          },
          "close_back_inside": {
            "description": "True when the candle closed back inside.",
            "title": "Close Back Inside",
            "type": "boolean"
          },
          "id": {
            "default": "",
            "description": "Deterministic content-hash ID.",
            "title": "Id",
            "type": "string"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional human-facing label.",
            "title": "Label"
          },
          "layer": {
            "default": "default",
            "description": "Render/grouping layer.",
            "title": "Layer",
            "type": "string"
          },
          "linked_break_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "False structure break linked to a STOP_HUNT, if any.",
            "title": "Linked Break Id"
          },
          "penetration_atr": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Wick penetration beyond the pool, in ATRs.",
            "title": "Penetration Atr"
          },
          "pool_id": {
            "description": "ID of the swept pool.",
            "minLength": 1,
            "title": "Pool Id",
            "type": "string"
          },
          "pool_price": {
            "exclusiveMinimum": 0,
            "title": "Pool Price",
            "type": "number"
          },
          "priority": {
            "default": 0,
            "description": "Render/selection priority (higher wins).",
            "title": "Priority",
            "type": "integer"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          },
          "side": {
            "$ref": "#/$defs/LiquiditySide"
          },
          "style": {
            "$ref": "#/$defs/VisualStyle"
          },
          "timestamp": {
            "description": "Sweeping candle timestamp (UTC).",
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "wick_extreme": {
            "description": "Deepest wick price beyond the pool.",
            "exclusiveMinimum": 0,
            "title": "Wick Extreme",
            "type": "number"
          }
        },
        "required": [
          "pool_id",
          "pool_price",
          "side",
          "candle_index",
          "timestamp",
          "wick_extreme",
          "close_back_inside",
          "classification"
        ],
        "title": "LiquiditySweep",
        "type": "object"
      },
      "PoolStatus": {
        "description": "Lifecycle of a liquidity pool.\n\n``UNTAPPED`` → ``SWEPT`` (wicked through, closed back inside) or\n``BROKEN`` (closed through = true break). Status transitions are\nmonotonic in scan order.",
        "enum": [
          "untapped",
          "swept",
          "broken"
        ],
        "title": "PoolStatus",
        "type": "string"
      },
      "RenderType": {
        "description": "Render primitives an analysis object can map to.",
        "enum": [
          "line",
          "area",
          "box",
          "marker",
          "label",
          "histogram",
          "candles"
        ],
        "title": "RenderType",
        "type": "string"
      },
      "SessionStats": {
        "additionalProperties": false,
        "description": "Statistics of one session instance (window x calendar date).",
        "properties": {
          "candle_count": {
            "description": "Candles inside the window.",
            "minimum": 1,
            "title": "Candle Count",
            "type": "integer"
          },
          "close": {
            "description": "Close of the last candle.",
            "exclusiveMinimum": 0,
            "title": "Close",
            "type": "number"
          },
          "direction": {
            "$ref": "#/$defs/TrendDirection",
            "description": "BULLISH/BEARISH from close vs open; RANGING when the body is below session_doji_body_fraction of the range."
          },
          "end_time": {
            "description": "Timestamp of the last candle (UTC).",
            "format": "date-time",
            "title": "End Time",
            "type": "string"
          },
          "forms_day_high": {
            "default": false,
            "description": "True when this instance printed the calendar-day high.",
            "title": "Forms Day High",
            "type": "boolean"
          },
          "forms_day_low": {
            "default": false,
            "description": "True when this instance printed the calendar-day low.",
            "title": "Forms Day Low",
            "type": "boolean"
          },
          "high": {
            "description": "Highest high inside the window.",
            "exclusiveMinimum": 0,
            "title": "High",
            "type": "number"
          },
          "high_index": {
            "description": "Candle index where the high formed.",
            "minimum": 0,
            "title": "High Index",
            "type": "integer"
          },
          "id": {
            "default": "",
            "description": "Deterministic content-hash ID.",
            "title": "Id",
            "type": "string"
          },
          "is_killzone": {
            "default": false,
            "description": "True for kill-zone windows.",
            "title": "Is Killzone",
            "type": "boolean"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional human-facing label.",
            "title": "Label"
          },
          "layer": {
            "default": "default",
            "description": "Render/grouping layer.",
            "title": "Layer",
            "type": "string"
          },
          "low": {
            "description": "Lowest low inside the window.",
            "exclusiveMinimum": 0,
            "title": "Low",
            "type": "number"
          },
          "low_index": {
            "description": "Candle index where the low formed.",
            "minimum": 0,
            "title": "Low Index",
            "type": "integer"
          },
          "open": {
            "description": "Open of the first candle.",
            "exclusiveMinimum": 0,
            "title": "Open",
            "type": "number"
          },
          "priority": {
            "default": 0,
            "description": "Render/selection priority (higher wins).",
            "title": "Priority",
            "type": "integer"
          },
          "range_atr": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Session range in ATRs at the session end (None if unknown).",
            "title": "Range Atr"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          },
          "session": {
            "description": "Window name from SessionConfig.",
            "minLength": 1,
            "title": "Session",
            "type": "string"
          },
          "start_time": {
            "description": "Timestamp of the first candle (UTC).",
            "format": "date-time",
            "title": "Start Time",
            "type": "string"
          },
          "style": {
            "$ref": "#/$defs/VisualStyle"
          },
          "trading_date": {
            "description": "Calendar date (in the session timezone) of the instance's start bar.",
            "format": "date",
            "title": "Trading Date",
            "type": "string"
          },
          "volume": {
            "description": "Accumulated volume.",
            "minimum": 0,
            "title": "Volume",
            "type": "number"
          }
        },
        "required": [
          "session",
          "trading_date",
          "start_time",
          "end_time",
          "open",
          "high",
          "low",
          "close",
          "high_index",
          "low_index",
          "candle_count",
          "volume",
          "direction"
        ],
        "title": "SessionStats",
        "type": "object"
      },
      "SessionSweep": {
        "additionalProperties": false,
        "description": "A Judas-swing event: a session level swept during an opposing killzone.\n\nPatterns (deterministic):\n    - Asian-range high/low swept during the London killzone;\n    - London high/low swept during the New York killzones.\nThe underlying stop-run is a normal :class:`LiquiditySweep` against a\nsession-derived pool; this object adds the session semantics.",
        "properties": {
          "candle_index": {
            "description": "Index of the sweeping candle.",
            "minimum": 0,
            "title": "Candle Index",
            "type": "integer"
          },
          "id": {
            "default": "",
            "description": "Deterministic content-hash ID.",
            "title": "Id",
            "type": "string"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional human-facing label.",
            "title": "Label"
          },
          "layer": {
            "default": "default",
            "description": "Render/grouping layer.",
            "title": "Layer",
            "type": "string"
          },
          "linked_sweep_id": {
            "description": "ID of the underlying LiquiditySweep.",
            "minLength": 1,
            "title": "Linked Sweep Id",
            "type": "string"
          },
          "priority": {
            "default": 0,
            "description": "Render/selection priority (higher wins).",
            "title": "Priority",
            "type": "integer"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          },
          "side": {
            "$ref": "#/$defs/LiquiditySide",
            "description": "BUYSIDE sweep of a high, SELLSIDE of a low."
          },
          "style": {
            "$ref": "#/$defs/VisualStyle"
          },
          "sweeping_window": {
            "description": "Killzone active at the sweep.",
            "minLength": 1,
            "title": "Sweeping Window",
            "type": "string"
          },
          "swept_group": {
            "description": "Level origin: 'asia' range or a session name.",
            "minLength": 1,
            "title": "Swept Group",
            "type": "string"
          },
          "swept_level_kind": {
            "$ref": "#/$defs/LiquidityPoolKind",
            "description": "SESSION_HIGH / SESSION_LOW / PREVIOUS_DAY_HIGH / PREVIOUS_DAY_LOW."
          },
          "swept_price": {
            "description": "Swept level price.",
            "exclusiveMinimum": 0,
            "title": "Swept Price",
            "type": "number"
          },
          "timestamp": {
            "description": "Sweeping candle timestamp (UTC).",
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          }
        },
        "required": [
          "swept_group",
          "swept_level_kind",
          "swept_price",
          "side",
          "sweeping_window",
          "candle_index",
          "timestamp",
          "linked_sweep_id"
        ],
        "title": "SessionSweep",
        "type": "object"
      },
      "SweepClassification": {
        "description": "Stop-run taxonomy.\n\n- ``SWEEP``: wick through the pool, close back inside, shallow penetration.\n- ``GRAB``: same shape but penetration >= ``sweep_grab_atr_fraction * ATR``.\n- ``STOP_HUNT``: sweep coinciding with a false structure break at the pool.",
        "enum": [
          "sweep",
          "grab",
          "stop_hunt"
        ],
        "title": "SweepClassification",
        "type": "string"
      },
      "SwingClass": {
        "description": "Internal (short lookback, noise-level) vs external (leg-level) swings.",
        "enum": [
          "internal",
          "external"
        ],
        "title": "SwingClass",
        "type": "string"
      },
      "TrendDirection": {
        "description": "Directional state of price, a candle, or a structure leg.",
        "enum": [
          "bullish",
          "bearish",
          "ranging",
          "unknown"
        ],
        "title": "TrendDirection",
        "type": "string"
      },
      "VisualStyle": {
        "additionalProperties": false,
        "description": "Renderer-agnostic drawing style for one analysis object.",
        "properties": {
          "color": {
            "description": "Primary color as '#rgb', '#rrggbb', or '#rrggbbaa'.",
            "title": "Color",
            "type": "string"
          },
          "fill": {
            "default": false,
            "description": "Fill the shape (boxes/areas).",
            "title": "Fill",
            "type": "boolean"
          },
          "layer": {
            "default": "default",
            "description": "Named layer for grouping/toggling.",
            "title": "Layer",
            "type": "string"
          },
          "line_style": {
            "$ref": "#/$defs/LineStyle",
            "default": "solid"
          },
          "line_width": {
            "default": 1.0,
            "description": "Stroke width in pixels.",
            "exclusiveMinimum": 0,
            "title": "Line Width",
            "type": "number"
          },
          "opacity": {
            "default": 1.0,
            "description": "Fill/line opacity.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Opacity",
            "type": "number"
          },
          "priority": {
            "default": 0,
            "description": "Z-order/selection priority (higher wins).",
            "title": "Priority",
            "type": "integer"
          },
          "render_type": {
            "$ref": "#/$defs/RenderType",
            "default": "box"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          },
          "tooltip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Hover text (renderer-formatted).",
            "title": "Tooltip"
          },
          "visible": {
            "default": true,
            "title": "Visible",
            "type": "boolean"
          }
        },
        "required": [
          "color"
        ],
        "title": "VisualStyle",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Payload of the sessions module.",
    "properties": {
      "day_high_counts": {
        "additionalProperties": {
          "type": "integer"
        },
        "description": "How often each window formed the calendar-day high.",
        "title": "Day High Counts",
        "type": "object"
      },
      "day_low_counts": {
        "additionalProperties": {
          "type": "integer"
        },
        "description": "How often each window formed the calendar-day low.",
        "title": "Day Low Counts",
        "type": "object"
      },
      "dominant_high_session": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Window that most often forms the day high (ties: first alphabetically).",
        "title": "Dominant High Session"
      },
      "dominant_low_session": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Window that most often forms the day low.",
        "title": "Dominant Low Session"
      },
      "pools": {
        "description": "Session-derived pools with final statuses.",
        "items": {
          "$ref": "#/$defs/LiquidityPool"
        },
        "title": "Pools",
        "type": "array"
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      },
      "session_sweeps": {
        "description": "Judas-swing events.",
        "items": {
          "$ref": "#/$defs/SessionSweep"
        },
        "title": "Session Sweeps",
        "type": "array"
      },
      "sessions": {
        "items": {
          "$ref": "#/$defs/SessionStats"
        },
        "title": "Sessions",
        "type": "array"
      },
      "sweeps": {
        "description": "Sweeps against session-derived pools.",
        "items": {
          "$ref": "#/$defs/LiquiditySweep"
        },
        "title": "Sweeps",
        "type": "array"
      }
    },
    "title": "SessionResult",
    "type": "object"
  },
  "name": "SessionResult",
  "schema_version": "1.0.0"
}
