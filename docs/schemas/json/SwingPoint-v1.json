{
  "engine_version": "0.1.0",
  "json_schema": {
    "$defs": {
      "LineStyle": {
        "description": "Stroke styles understood by both Plotly and Lightweight Charts.",
        "enum": [
          "solid",
          "dashed",
          "dotted"
        ],
        "title": "LineStyle",
        "type": "string"
      },
      "RenderType": {
        "description": "Render primitives an analysis object can map to.",
        "enum": [
          "line",
          "area",
          "box",
          "marker",
          "label",
          "histogram",
          "candles"
        ],
        "title": "RenderType",
        "type": "string"
      },
      "SwingClass": {
        "description": "Internal (short lookback, noise-level) vs external (leg-level) swings.",
        "enum": [
          "internal",
          "external"
        ],
        "title": "SwingClass",
        "type": "string"
      },
      "SwingType": {
        "description": "Kind of a detected swing point.",
        "enum": [
          "high",
          "low"
        ],
        "title": "SwingType",
        "type": "string"
      },
      "VisualStyle": {
        "additionalProperties": false,
        "description": "Renderer-agnostic drawing style for one analysis object.",
        "properties": {
          "color": {
            "description": "Primary color as '#rgb', '#rrggbb', or '#rrggbbaa'.",
            "title": "Color",
            "type": "string"
          },
          "fill": {
            "default": false,
            "description": "Fill the shape (boxes/areas).",
            "title": "Fill",
            "type": "boolean"
          },
          "layer": {
            "default": "default",
            "description": "Named layer for grouping/toggling.",
            "title": "Layer",
            "type": "string"
          },
          "line_style": {
            "$ref": "#/$defs/LineStyle",
            "default": "solid"
          },
          "line_width": {
            "default": 1.0,
            "description": "Stroke width in pixels.",
            "exclusiveMinimum": 0,
            "title": "Line Width",
            "type": "number"
          },
          "opacity": {
            "default": 1.0,
            "description": "Fill/line opacity.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Opacity",
            "type": "number"
          },
          "priority": {
            "default": 0,
            "description": "Z-order/selection priority (higher wins).",
            "title": "Priority",
            "type": "integer"
          },
          "render_type": {
            "$ref": "#/$defs/RenderType",
            "default": "box"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          },
          "tooltip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Hover text (renderer-formatted).",
            "title": "Tooltip"
          },
          "visible": {
            "default": true,
            "title": "Visible",
            "type": "boolean"
          }
        },
        "required": [
          "color"
        ],
        "title": "VisualStyle",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "A fractal swing high/low.\n\nIdentity hashes every field except ``id``/``label`` — identical\ndetections (same index, price, class) get identical IDs across runs.",
    "properties": {
      "id": {
        "default": "",
        "description": "Deterministic content-hash ID.",
        "title": "Id",
        "type": "string"
      },
      "index": {
        "description": "Candle index of the swing bar.",
        "minimum": 0,
        "title": "Index",
        "type": "integer"
      },
      "label": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Optional human-facing label.",
        "title": "Label"
      },
      "layer": {
        "default": "default",
        "description": "Render/grouping layer.",
        "title": "Layer",
        "type": "string"
      },
      "lookback": {
        "description": "Neighbor bars required each side.",
        "minimum": 1,
        "title": "Lookback",
        "type": "integer"
      },
      "price": {
        "description": "High (swing high) or low (swing low) price.",
        "exclusiveMinimum": 0,
        "title": "Price",
        "type": "number"
      },
      "priority": {
        "default": 0,
        "description": "Render/selection priority (higher wins).",
        "title": "Priority",
        "type": "integer"
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      },
      "style": {
        "$ref": "#/$defs/VisualStyle",
        "description": "Render style; engines set it via swing_style()."
      },
      "swing_class": {
        "$ref": "#/$defs/SwingClass",
        "description": "Internal (noise) vs external (leg-level)."
      },
      "swing_type": {
        "$ref": "#/$defs/SwingType"
      },
      "timestamp": {
        "description": "Swing bar timestamp (UTC).",
        "format": "date-time",
        "title": "Timestamp",
        "type": "string"
      }
    },
    "required": [
      "index",
      "timestamp",
      "price",
      "swing_type",
      "swing_class",
      "lookback"
    ],
    "title": "SwingPoint",
    "type": "object"
  },
  "name": "SwingPoint",
  "schema_version": "1.0.0"
}
