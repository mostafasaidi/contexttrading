{
  "engine_version": "0.1.0",
  "json_schema": {
    "$defs": {
      "ConfidenceScore": {
        "additionalProperties": false,
        "description": "Confidence with a mandatory evidence-based justification.",
        "properties": {
          "factor_ids": {
            "description": "Confluence factor keys the score leans on.",
            "items": {
              "type": "string"
            },
            "title": "Factor Ids",
            "type": "array"
          },
          "justification": {
            "$ref": "#/$defs/EvidenceStatement"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          },
          "score": {
            "maximum": 1,
            "minimum": 0,
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
          "score",
          "justification"
        ],
        "title": "ConfidenceScore",
        "type": "object"
      },
      "DataQualityDeclaration": {
        "additionalProperties": false,
        "description": "The AI's mandatory declaration of input-data limitations.",
        "properties": {
          "level": {
            "enum": [
              "good",
              "fair",
              "poor"
            ],
            "title": "Level",
            "type": "string"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "level"
        ],
        "title": "DataQualityDeclaration",
        "type": "object"
      },
      "DisciplineFlag": {
        "additionalProperties": false,
        "description": "One emotional-discipline flag, derived ONLY from provided statistics.",
        "properties": {
          "detected": {
            "title": "Detected",
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "revenge_trading",
              "overtrading",
              "impatience",
              "poor_risk_management",
              "other"
            ],
            "title": "Kind",
            "type": "string"
          },
          "rationale": {
            "$ref": "#/$defs/EvidenceStatement"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "detected",
          "rationale"
        ],
        "title": "DisciplineFlag",
        "type": "object"
      },
      "EvidenceStatement": {
        "additionalProperties": false,
        "description": "A constrained text claim with its supporting engine-object ids.",
        "properties": {
          "evidence_ids": {
            "description": "Ids into the context evidence_index backing this claim.",
            "items": {
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          },
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "EvidenceStatement",
        "type": "object"
      },
      "ReportProvenance": {
        "additionalProperties": false,
        "description": "How a report was produced — prompt, provider, and validation trail.",
        "properties": {
          "model": {
            "default": "",
            "title": "Model",
            "type": "string"
          },
          "prompt_name": {
            "minLength": 1,
            "title": "Prompt Name",
            "type": "string"
          },
          "prompt_sha256": {
            "maxLength": 64,
            "minLength": 64,
            "title": "Prompt Sha256",
            "type": "string"
          },
          "prompt_version": {
            "minLength": 1,
            "title": "Prompt Version",
            "type": "string"
          },
          "provider": {
            "minLength": 1,
            "title": "Provider",
            "type": "string"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          },
          "validation_warnings": {
            "items": {
              "type": "string"
            },
            "title": "Validation Warnings",
            "type": "array"
          }
        },
        "required": [
          "prompt_name",
          "prompt_version",
          "prompt_sha256",
          "provider"
        ],
        "title": "ReportProvenance",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "MP03 journal review: patterns from provided journal statistics only.",
    "properties": {
      "confidence_score": {
        "$ref": "#/$defs/ConfidenceScore"
      },
      "data_quality": {
        "$ref": "#/$defs/DataQualityDeclaration"
      },
      "discipline_flags": {
        "items": {
          "$ref": "#/$defs/DisciplineFlag"
        },
        "title": "Discipline Flags",
        "type": "array"
      },
      "evidence_citations": {
        "items": {
          "type": "string"
        },
        "title": "Evidence Citations",
        "type": "array"
      },
      "improvement_plan": {
        "items": {
          "$ref": "#/$defs/EvidenceStatement"
        },
        "title": "Improvement Plan",
        "type": "array"
      },
      "provenance": {
        "anyOf": [
          {
            "$ref": "#/$defs/ReportProvenance"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "recurring_mistakes": {
        "items": {
          "$ref": "#/$defs/EvidenceStatement"
        },
        "title": "Recurring Mistakes",
        "type": "array"
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      },
      "strengths": {
        "items": {
          "$ref": "#/$defs/EvidenceStatement"
        },
        "title": "Strengths",
        "type": "array"
      }
    },
    "required": [
      "confidence_score",
      "data_quality"
    ],
    "title": "JournalReviewReport",
    "type": "object"
  },
  "name": "JournalReviewReport",
  "schema_version": "1.0.0"
}
