{
  "engine_version": "0.1.0",
  "json_schema": {
    "$defs": {
      "TrendDirection": {
        "description": "Directional state of price, a candle, or a structure leg.",
        "enum": [
          "bullish",
          "bearish",
          "ranging",
          "unknown"
        ],
        "title": "TrendDirection",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "description": "One piece of directional evidence with its weighted contribution.\n\n``direction`` is the side the evidence supports (RANGING = evaluated\nbut no directional evidence — it still dilutes the normalized scores).\n``contribution`` is exactly ``weight * raw``.",
    "properties": {
      "contribution": {
        "description": "weight * raw.",
        "minimum": 0,
        "title": "Contribution",
        "type": "number"
      },
      "detail": {
        "description": "Deterministic self-describing summary for narration.",
        "minLength": 1,
        "title": "Detail",
        "type": "string"
      },
      "direction": {
        "$ref": "#/$defs/TrendDirection",
        "description": "Side the evidence supports."
      },
      "factor": {
        "description": "Factor kind, e.g. 'trend', 'fvg'.",
        "minLength": 1,
        "title": "Factor",
        "type": "string"
      },
      "raw": {
        "description": "Evidence strength in [0, 1].",
        "maximum": 1,
        "minimum": 0,
        "title": "Raw",
        "type": "number"
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      },
      "source_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "ID of the backing object (None for aggregate factors).",
        "title": "Source Id"
      },
      "weight": {
        "description": "Configured factor weight.",
        "minimum": 0,
        "title": "Weight",
        "type": "number"
      }
    },
    "required": [
      "factor",
      "direction",
      "weight",
      "raw",
      "contribution",
      "detail"
    ],
    "title": "FactorContribution",
    "type": "object"
  },
  "name": "FactorContribution",
  "schema_version": "1.0.0"
}
