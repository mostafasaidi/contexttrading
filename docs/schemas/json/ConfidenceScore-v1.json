{
  "engine_version": "0.1.0",
  "json_schema": {
    "$defs": {
      "EvidenceStatement": {
        "additionalProperties": false,
        "description": "A constrained text claim with its supporting engine-object ids.",
        "properties": {
          "evidence_ids": {
            "description": "Ids into the context evidence_index backing this claim.",
            "items": {
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          },
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "EvidenceStatement",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Confidence with a mandatory evidence-based justification.",
    "properties": {
      "factor_ids": {
        "description": "Confluence factor keys the score leans on.",
        "items": {
          "type": "string"
        },
        "title": "Factor Ids",
        "type": "array"
      },
      "justification": {
        "$ref": "#/$defs/EvidenceStatement"
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      },
      "score": {
        "maximum": 1,
        "minimum": 0,
        "title": "Score",
        "type": "number"
      }
    },
    "required": [
      "score",
      "justification"
    ],
    "title": "ConfidenceScore",
    "type": "object"
  },
  "name": "ConfidenceScore",
  "schema_version": "1.0.0"
}
