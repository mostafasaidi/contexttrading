{
  "engine_version": "0.1.0",
  "json_schema": {
    "additionalProperties": false,
    "description": "Caller-supplied proposed trade (input to trade evaluation).",
    "properties": {
      "direction": {
        "enum": [
          "long",
          "short"
        ],
        "title": "Direction",
        "type": "string"
      },
      "entry_price": {
        "exclusiveMinimum": 0,
        "title": "Entry Price",
        "type": "number"
      },
      "rationale": {
        "default": "",
        "maxLength": 2000,
        "title": "Rationale",
        "type": "string"
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      },
      "stop_loss": {
        "exclusiveMinimum": 0,
        "title": "Stop Loss",
        "type": "number"
      },
      "take_profits": {
        "items": {
          "type": "number"
        },
        "minItems": 1,
        "title": "Take Profits",
        "type": "array"
      }
    },
    "required": [
      "direction",
      "entry_price",
      "stop_loss",
      "take_profits"
    ],
    "title": "TradeSetup",
    "type": "object"
  },
  "name": "TradeSetup",
  "schema_version": "1.0.0"
}
