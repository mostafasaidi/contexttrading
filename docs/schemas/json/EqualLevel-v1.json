{
  "engine_version": "0.1.0",
  "json_schema": {
    "$defs": {
      "LineStyle": {
        "description": "Stroke styles understood by both Plotly and Lightweight Charts.",
        "enum": [
          "solid",
          "dashed",
          "dotted"
        ],
        "title": "LineStyle",
        "type": "string"
      },
      "LiquiditySide": {
        "description": "Side of the book where resting liquidity sits.",
        "enum": [
          "buyside",
          "sellside"
        ],
        "title": "LiquiditySide",
        "type": "string"
      },
      "RenderType": {
        "description": "Render primitives an analysis object can map to.",
        "enum": [
          "line",
          "area",
          "box",
          "marker",
          "label",
          "histogram",
          "candles"
        ],
        "title": "RenderType",
        "type": "string"
      },
      "VisualStyle": {
        "additionalProperties": false,
        "description": "Renderer-agnostic drawing style for one analysis object.",
        "properties": {
          "color": {
            "description": "Primary color as '#rgb', '#rrggbb', or '#rrggbbaa'.",
            "title": "Color",
            "type": "string"
          },
          "fill": {
            "default": false,
            "description": "Fill the shape (boxes/areas).",
            "title": "Fill",
            "type": "boolean"
          },
          "layer": {
            "default": "default",
            "description": "Named layer for grouping/toggling.",
            "title": "Layer",
            "type": "string"
          },
          "line_style": {
            "$ref": "#/$defs/LineStyle",
            "default": "solid"
          },
          "line_width": {
            "default": 1.0,
            "description": "Stroke width in pixels.",
            "exclusiveMinimum": 0,
            "title": "Line Width",
            "type": "number"
          },
          "opacity": {
            "default": 1.0,
            "description": "Fill/line opacity.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Opacity",
            "type": "number"
          },
          "priority": {
            "default": 0,
            "description": "Z-order/selection priority (higher wins).",
            "title": "Priority",
            "type": "integer"
          },
          "render_type": {
            "$ref": "#/$defs/RenderType",
            "default": "box"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          },
          "tooltip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Hover text (renderer-formatted).",
            "title": "Tooltip"
          },
          "visible": {
            "default": true,
            "title": "Visible",
            "type": "boolean"
          }
        },
        "required": [
          "color"
        ],
        "title": "VisualStyle",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Two or more swings at (nearly) the same price.",
    "properties": {
      "count": {
        "description": "Number of member swings.",
        "minimum": 2,
        "title": "Count",
        "type": "integer"
      },
      "id": {
        "default": "",
        "description": "Deterministic content-hash ID.",
        "title": "Id",
        "type": "string"
      },
      "label": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Optional human-facing label.",
        "title": "Label"
      },
      "layer": {
        "default": "default",
        "description": "Render/grouping layer.",
        "title": "Layer",
        "type": "string"
      },
      "member_swing_ids": {
        "description": "Swing IDs forming the level.",
        "items": {
          "type": "string"
        },
        "minItems": 2,
        "title": "Member Swing Ids",
        "type": "array"
      },
      "price": {
        "description": "Mean price of the member swings.",
        "exclusiveMinimum": 0,
        "title": "Price",
        "type": "number"
      },
      "priority": {
        "default": 0,
        "description": "Render/selection priority (higher wins).",
        "title": "Priority",
        "type": "integer"
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      },
      "side": {
        "$ref": "#/$defs/LiquiditySide",
        "description": "BUYSIDE for equal highs, SELLSIDE for equal lows."
      },
      "style": {
        "$ref": "#/$defs/VisualStyle"
      },
      "tolerance": {
        "description": "ATR-fraction tolerance actually used (price).",
        "minimum": 0,
        "title": "Tolerance",
        "type": "number"
      }
    },
    "required": [
      "price",
      "side",
      "member_swing_ids",
      "count",
      "tolerance"
    ],
    "title": "EqualLevel",
    "type": "object"
  },
  "name": "EqualLevel",
  "schema_version": "1.0.0"
}
