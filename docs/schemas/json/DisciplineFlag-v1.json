{
  "engine_version": "0.1.0",
  "json_schema": {
    "$defs": {
      "EvidenceStatement": {
        "additionalProperties": false,
        "description": "A constrained text claim with its supporting engine-object ids.",
        "properties": {
          "evidence_ids": {
            "description": "Ids into the context evidence_index backing this claim.",
            "items": {
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          },
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "EvidenceStatement",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "One emotional-discipline flag, derived ONLY from provided statistics.",
    "properties": {
      "detected": {
        "title": "Detected",
        "type": "boolean"
      },
      "kind": {
        "enum": [
          "revenge_trading",
          "overtrading",
          "impatience",
          "poor_risk_management",
          "other"
        ],
        "title": "Kind",
        "type": "string"
      },
      "rationale": {
        "$ref": "#/$defs/EvidenceStatement"
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      }
    },
    "required": [
      "kind",
      "detected",
      "rationale"
    ],
    "title": "DisciplineFlag",
    "type": "object"
  },
  "name": "DisciplineFlag",
  "schema_version": "1.0.0"
}
