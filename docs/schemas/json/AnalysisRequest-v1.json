{
  "engine_version": "0.1.0",
  "json_schema": {
    "$defs": {
      "CandlesInput": {
        "additionalProperties": false,
        "description": "Posted candle series (CandleSeries-compatible records).",
        "properties": {
          "candles": {
            "description": "OHLCV records: timestamp/open/high/low/close/volume.",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "minItems": 1,
            "title": "Candles",
            "type": "array"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          },
          "symbol": {
            "minLength": 1,
            "title": "Symbol",
            "type": "string"
          },
          "timeframe": {
            "description": "Timeframe code, e.g. '15m'.",
            "minLength": 1,
            "title": "Timeframe",
            "type": "string"
          },
          "timezone_name": {
            "default": "UTC",
            "description": "Original feed timezone label.",
            "title": "Timezone Name",
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "timeframe",
          "candles"
        ],
        "title": "CandlesInput",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Single-module or full-stack analysis request.",
    "properties": {
      "config_overrides": {
        "additionalProperties": true,
        "description": "Subset of EngineConfig fields; unknown keys are rejected (422).",
        "title": "Config Overrides",
        "type": "object"
      },
      "mtf_timeframes": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "HTF ladder for mtf/full-stack runs (default ['1h', '4h']).",
        "title": "Mtf Timeframes"
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      },
      "series": {
        "$ref": "#/$defs/CandlesInput"
      }
    },
    "required": [
      "series"
    ],
    "title": "AnalysisRequest",
    "type": "object"
  },
  "name": "AnalysisRequest",
  "schema_version": "1.0.0"
}
