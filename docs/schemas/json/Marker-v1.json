{
  "engine_version": "0.1.0",
  "json_schema": {
    "additionalProperties": false,
    "description": "Point marker at a candle (swings, sweeps, Judas events).",
    "properties": {
      "color": {
        "description": "Copied from the source object's VisualStyle.",
        "title": "Color",
        "type": "string"
      },
      "layer": {
        "description": "Named layer (grouping/toggling).",
        "minLength": 1,
        "title": "Layer",
        "type": "string"
      },
      "position": {
        "enum": [
          "aboveBar",
          "belowBar"
        ],
        "title": "Position",
        "type": "string"
      },
      "price": {
        "description": "Anchor price (swing/extreme).",
        "exclusiveMinimum": 0,
        "title": "Price",
        "type": "number"
      },
      "primitive": {
        "const": "marker",
        "default": "marker",
        "title": "Primitive",
        "type": "string"
      },
      "priority": {
        "default": 0,
        "description": "In-layer stacking priority.",
        "title": "Priority",
        "type": "integer"
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      },
      "shape": {
        "enum": [
          "arrowUp",
          "arrowDown",
          "circle",
          "diamond",
          "square"
        ],
        "title": "Shape",
        "type": "string"
      },
      "source_id": {
        "description": "ID of the backing AnalysisObject.",
        "minLength": 1,
        "title": "Source Id",
        "type": "string"
      },
      "text": {
        "default": "",
        "description": "Short marker text.",
        "title": "Text",
        "type": "string"
      },
      "time": {
        "description": "Candle time, UNIX seconds.",
        "minimum": 0,
        "title": "Time",
        "type": "integer"
      },
      "tooltip": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "Structured key/value pairs from the source object (deterministic).",
        "title": "Tooltip",
        "type": "object"
      },
      "z_order": {
        "default": 0,
        "description": "Global stacking order: layer_rank * 100 + priority.",
        "title": "Z Order",
        "type": "integer"
      }
    },
    "required": [
      "source_id",
      "layer",
      "color",
      "time",
      "price",
      "position",
      "shape"
    ],
    "title": "Marker",
    "type": "object"
  },
  "name": "Marker",
  "schema_version": "1.0.0"
}
