{
  "engine_version": "0.1.0",
  "json_schema": {
    "additionalProperties": false,
    "description": "A window of missing candles inside a series.",
    "properties": {
      "end": {
        "description": "Timestamp of the first candle after the gap.",
        "format": "date-time",
        "title": "End",
        "type": "string"
      },
      "missing_candles": {
        "description": "Number of expected candles absent.",
        "minimum": 1,
        "title": "Missing Candles",
        "type": "integer"
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      },
      "start": {
        "description": "Timestamp of the last candle before the gap.",
        "format": "date-time",
        "title": "Start",
        "type": "string"
      }
    },
    "required": [
      "start",
      "end",
      "missing_candles"
    ],
    "title": "GapWindow",
    "type": "object"
  },
  "name": "GapWindow",
  "schema_version": "1.0.0"
}
