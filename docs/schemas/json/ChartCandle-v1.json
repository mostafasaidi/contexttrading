{
  "engine_version": "0.1.0",
  "json_schema": {
    "additionalProperties": false,
    "description": "One OHLC candle in Lightweight Charts format (time in seconds).",
    "properties": {
      "close": {
        "exclusiveMinimum": 0,
        "title": "Close",
        "type": "number"
      },
      "high": {
        "exclusiveMinimum": 0,
        "title": "High",
        "type": "number"
      },
      "low": {
        "exclusiveMinimum": 0,
        "title": "Low",
        "type": "number"
      },
      "open": {
        "exclusiveMinimum": 0,
        "title": "Open",
        "type": "number"
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      },
      "time": {
        "description": "Candle open time, UNIX seconds (UTC).",
        "minimum": 0,
        "title": "Time",
        "type": "integer"
      }
    },
    "required": [
      "time",
      "open",
      "high",
      "low",
      "close"
