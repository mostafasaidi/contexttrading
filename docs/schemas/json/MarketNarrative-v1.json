{
  "engine_version": "0.1.0",
  "json_schema": {
    "$defs": {
      "EvidenceStatement": {
        "additionalProperties": false,
        "description": "A constrained text claim with its supporting engine-object ids.",
        "properties": {
          "evidence_ids": {
            "description": "Ids into the context evidence_index backing this claim.",
            "items": {
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          },
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "EvidenceStatement",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "MP03 narrative sections — each one an evidence-bound statement.",
    "properties": {
      "accumulation_distribution": {
        "$ref": "#/$defs/EvidenceStatement"
      },
      "control": {
        "$ref": "#/$defs/EvidenceStatement",
        "description": "Which side controls the market and why."
      },
      "expansion_correction": {
        "$ref": "#/$defs/EvidenceStatement"
      },
      "liquidity_objectives": {
        "$ref": "#/$defs/EvidenceStatement",
        "description": "Where resting liquidity likely sits (untapped pools, equal levels)."
      },
      "momentum": {
        "$ref": "#/$defs/EvidenceStatement"
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      },
      "trend_health": {
        "$ref": "#/$defs/EvidenceStatement"
      }
    },
    "required": [
      "control",
      "liquidity_objectives",
      "trend_health",
      "momentum",
      "accumulation_distribution",
      "expansion_correction"
    ],
    "title": "MarketNarrative",
    "type": "object"
  },
  "name": "MarketNarrative",
  "schema_version": "1.0.0"
}
