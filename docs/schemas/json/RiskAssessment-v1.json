{
  "engine_version": "0.1.0",
  "json_schema": {
    "$defs": {
      "EvidenceStatement": {
        "additionalProperties": false,
        "description": "A constrained text claim with its supporting engine-object ids.",
        "properties": {
          "evidence_ids": {
            "description": "Ids into the context evidence_index backing this claim.",
            "items": {
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          },
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "EvidenceStatement",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "MP03 risk block: categorized levels + sizing + capital preservation.",
    "properties": {
      "capital_preservation_notes": {
        "$ref": "#/$defs/EvidenceStatement"
      },
      "liquidity_risk": {
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "title": "Liquidity Risk",
        "type": "string"
      },
      "market_risk": {
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "title": "Market Risk",
        "type": "string"
      },
      "news_risk": {
        "description": "'high' only from input flags, never assumed.",
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "title": "News Risk",
        "type": "string"
      },
      "position_size_suggestion": {
        "enum": [
          "avoid",
          "reduced",
          "normal"
        ],
        "title": "Position Size Suggestion",
        "type": "string"
      },
      "risk_rationale": {
        "$ref": "#/$defs/EvidenceStatement"
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      },
      "session_risk": {
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "title": "Session Risk",
        "type": "string"
      },
      "trend_risk": {
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "title": "Trend Risk",
        "type": "string"
      },
      "volatility_risk": {
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "title": "Volatility Risk",
        "type": "string"
      }
    },
    "required": [
      "market_risk",
      "liquidity_risk",
      "volatility_risk",
      "session_risk",
      "news_risk",
      "trend_risk",
      "position_size_suggestion",
      "risk_rationale",
      "capital_preservation_notes"
    ],
    "title": "RiskAssessment",
    "type": "object"
  },
  "name": "RiskAssessment",
  "schema_version": "1.0.0"
}
