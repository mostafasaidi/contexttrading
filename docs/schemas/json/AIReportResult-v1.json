{
  "engine_version": "0.1.0",
  "json_schema": {
    "$defs": {
      "DataWindow": {
        "additionalProperties": false,
        "description": "The exact input-data window an analysis was generated from.\n\nTimestamps always derive from candle data (never wall-clock) per the\ndeterminism contract.",
        "properties": {
          "candle_count": {
            "description": "Number of input candles.",
            "minimum": 0,
            "title": "Candle Count",
            "type": "integer"
          },
          "end": {
            "description": "Last input candle timestamp (UTC).",
            "format": "date-time",
            "title": "End",
            "type": "string"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          },
          "start": {
            "description": "First input candle timestamp (UTC).",
            "format": "date-time",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "candle_count"
        ],
        "title": "DataWindow",
        "type": "object"
      },
      "VersionedModel": {
        "additionalProperties": false,
        "description": "Base for all versioned, serializable models.\n\nSubclasses set ``SCHEMA_VERSION``; the ``schema_version`` field defaults\nto it and rejects mismatched values, so payloads can never silently drift\nfrom the class that validates them.",
        "properties": {
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "title": "VersionedModel",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Envelope for AI-layer reports (AnalysisResult-style).\n\nUnlike the engine envelope, the subject may be a journal/performance\nperiod rather than a market series, so ``generated_from`` is optional\nand ``subject`` carries \"SYMBOL/timeframe\" or \"journal:PERIOD\".",
    "properties": {
      "engine_version": {
        "default": "0.1.0",
        "description": "contexttrading version that produced this.",
        "title": "Engine Version",
        "type": "string"
      },
      "generated_from": {
        "anyOf": [
          {
            "$ref": "#/$defs/DataWindow"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Market data window when the subject is a series."
      },
      "module": {
        "description": "e.g. 'ai.market_analysis'.",
        "minLength": 1,
        "title": "Module",
        "type": "string"
      },
      "payload": {
        "$ref": "#/$defs/VersionedModel"
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      },
      "subject": {
        "description": "'SYMBOL/timeframe' or 'journal:period'.",
        "minLength": 1,
        "title": "Subject",
        "type": "string"
      }
    },
    "required": [
      "module",
      "subject",
      "payload"
    ],
    "title": "AIReportResult",
    "type": "object"
  },
  "name": "AIReportResult",
  "schema_version": "1.0.0"
}
