{
  "engine_version": "0.1.0",
  "json_schema": {
    "$defs": {
      "OptimizationEntry": {
        "additionalProperties": false,
        "description": "One evaluated parameter combination.",
        "properties": {
          "net_pnl": {
            "title": "Net Pnl",
            "type": "number"
          },
          "objective": {
            "description": "Objective metric name.",
            "title": "Objective",
            "type": "string"
          },
          "objective_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "None when the metric is undefined.",
            "title": "Objective Value"
          },
          "params": {
            "additionalProperties": true,
            "description": "Dotted-path -> value used for this run.",
            "title": "Params",
            "type": "object"
          },
          "rank": {
            "minimum": 1,
            "title": "Rank",
            "type": "integer"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          },
          "statistics_reliable": {
            "title": "Statistics Reliable",
            "type": "boolean"
          },
          "total_trades": {
            "title": "Total Trades",
            "type": "integer"
          }
        },
        "required": [
          "rank",
          "params",
          "objective",
          "objective_value",
          "net_pnl",
          "total_trades",
          "statistics_reliable"
        ],
        "title": "OptimizationEntry",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Deterministic grid-search output (leaderboard in rank order).",
    "properties": {
      "combos_evaluated": {
        "minimum": 0,
        "title": "Combos Evaluated",
        "type": "integer"
      },
      "leaderboard": {
        "items": {
          "$ref": "#/$defs/OptimizationEntry"
        },
        "title": "Leaderboard",
        "type": "array"
      },
      "module": {
        "default": "backtest.optimize",
        "title": "Module",
        "type": "string"
      },
      "objective": {
        "title": "Objective",
        "type": "string"
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      },
      "strategy": {
        "title": "Strategy",
        "type": "string"
      }
    },
    "required": [
      "strategy",
      "objective",
      "combos_evaluated"
    ],
    "title": "OptimizationResult",
    "type": "object"
  },
  "name": "OptimizationResult",
  "schema_version": "1.0.0"
}
