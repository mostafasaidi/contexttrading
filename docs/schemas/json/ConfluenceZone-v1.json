{
  "engine_version": "0.1.0",
  "json_schema": {
    "$defs": {
      "LineStyle": {
        "description": "Stroke styles understood by both Plotly and Lightweight Charts.",
        "enum": [
          "solid",
          "dashed",
          "dotted"
        ],
        "title": "LineStyle",
        "type": "string"
      },
      "RenderType": {
        "description": "Render primitives an analysis object can map to.",
        "enum": [
          "line",
          "area",
          "box",
          "marker",
          "label",
          "histogram",
          "candles"
        ],
        "title": "RenderType",
        "type": "string"
      },
      "TrendDirection": {
        "description": "Directional state of price, a candle, or a structure leg.",
        "enum": [
          "bullish",
          "bearish",
          "ranging",
          "unknown"
        ],
        "title": "TrendDirection",
        "type": "string"
      },
      "VisualStyle": {
        "additionalProperties": false,
        "description": "Renderer-agnostic drawing style for one analysis object.",
        "properties": {
          "color": {
            "description": "Primary color as '#rgb', '#rrggbb', or '#rrggbbaa'.",
            "title": "Color",
            "type": "string"
          },
          "fill": {
            "default": false,
            "description": "Fill the shape (boxes/areas).",
            "title": "Fill",
            "type": "boolean"
          },
          "layer": {
            "default": "default",
            "description": "Named layer for grouping/toggling.",
            "title": "Layer",
            "type": "string"
          },
          "line_style": {
            "$ref": "#/$defs/LineStyle",
            "default": "solid"
          },
          "line_width": {
            "default": 1.0,
            "description": "Stroke width in pixels.",
            "exclusiveMinimum": 0,
            "title": "Line Width",
            "type": "number"
          },
          "opacity": {
            "default": 1.0,
            "description": "Fill/line opacity.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Opacity",
            "type": "number"
          },
          "priority": {
            "default": 0,
            "description": "Z-order/selection priority (higher wins).",
            "title": "Priority",
            "type": "integer"
          },
          "render_type": {
            "$ref": "#/$defs/RenderType",
            "default": "box"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          },
          "tooltip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Hover text (renderer-formatted).",
            "title": "Tooltip"
          },
          "visible": {
            "default": true,
            "title": "Visible",
            "type": "boolean"
          }
        },
        "required": [
          "color"
        ],
        "title": "VisualStyle",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "A price band where several factor kinds spatially overlap.\n\nEmitted only when at least ``conf_zone_min_factors`` distinct factor\nkinds overlap AND all member zones agree in direction. ``score`` is the\nraw-weighted kind coverage normalized by the full zone-kind weight set,\nso a zone with every kind at full strength scores 1.0.",
    "properties": {
      "direction": {
        "$ref": "#/$defs/TrendDirection",
        "description": "Unanimous member direction."
      },
      "id": {
        "default": "",
        "description": "Deterministic content-hash ID.",
        "title": "Id",
        "type": "string"
      },
      "label": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Optional human-facing label.",
        "title": "Label"
      },
      "layer": {
        "default": "default",
        "description": "Render/grouping layer.",
        "title": "Layer",
        "type": "string"
      },
      "member_ids": {
        "description": "Backing object IDs, ordered by zone bottom.",
        "items": {
          "type": "string"
        },
        "minItems": 2,
        "title": "Member Ids",
        "type": "array"
      },
      "member_kinds": {
        "description": "Distinct factor kinds present (sorted).",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "title": "Member Kinds",
        "type": "array"
      },
      "priority": {
        "default": 0,
        "description": "Render/selection priority (higher wins).",
        "title": "Priority",
        "type": "integer"
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      },
      "score": {
        "description": "Normalized confluence score in [0, 1].",
        "maximum": 1,
        "minimum": 0,
        "title": "Score",
        "type": "number"
      },
      "style": {
        "$ref": "#/$defs/VisualStyle"
      },
      "zone_bottom": {
        "description": "Envelope lower bound.",
        "exclusiveMinimum": 0,
        "title": "Zone Bottom",
        "type": "number"
      },
      "zone_top": {
        "description": "Envelope upper bound.",
        "exclusiveMinimum": 0,
        "title": "Zone Top",
        "type": "number"
      }
    },
    "required": [
      "direction",
      "zone_bottom",
      "zone_top",
      "member_ids",
      "member_kinds",
      "score"
    ],
    "title": "ConfluenceZone",
    "type": "object"
  },
  "name": "ConfluenceZone",
  "schema_version": "1.0.0"
}
