{
  "engine_version": "0.1.0",
  "json_schema": {
    "$defs": {
      "EvidenceStatement": {
        "additionalProperties": false,
        "description": "A constrained text claim with its supporting engine-object ids.",
        "properties": {
          "evidence_ids": {
            "description": "Ids into the context evidence_index backing this claim.",
            "items": {
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          },
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "EvidenceStatement",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "MP03 trade evaluation — every judgment evidence-bound.",
    "properties": {
      "alternative_entries": {
        "items": {
          "$ref": "#/$defs/EvidenceStatement"
        },
        "title": "Alternative Entries",
        "type": "array"
      },
      "confluence_alignment": {
        "$ref": "#/$defs/EvidenceStatement"
      },
      "entry_quality": {
        "enum": [
          "poor",
          "fair",
          "good",
          "excellent"
        ],
        "title": "Entry Quality",
        "type": "string"
      },
      "invalidation": {
        "$ref": "#/$defs/EvidenceStatement",
        "description": "Conditions that void the setup, citing structure/liquidity objects."
      },
      "overall": {
        "$ref": "#/$defs/EvidenceStatement"
      },
      "probability": {
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "title": "Probability",
        "type": "string"
      },
      "rr_assessment": {
        "$ref": "#/$defs/EvidenceStatement",
        "description": "Interpretation of the caller-provided reward/risk only — never recomputed."
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      },
      "stop_loss_quality": {
        "enum": [
          "poor",
          "fair",
          "good",
          "excellent"
        ],
        "title": "Stop Loss Quality",
        "type": "string"
      },
      "take_profit_quality": {
        "enum": [
          "poor",
          "fair",
          "good",
          "excellent"
        ],
        "title": "Take Profit Quality",
        "type": "string"
      },
      "timing": {
        "$ref": "#/$defs/EvidenceStatement"
      }
    },
    "required": [
      "entry_quality",
      "stop_loss_quality",
      "take_profit_quality",
      "rr_assessment",
      "confluence_alignment",
      "timing",
      "probability",
      "invalidation",
      "overall"
    ],
    "title": "TradeEvaluation",
    "type": "object"
  },
  "name": "TradeEvaluation",
  "schema_version": "1.0.0"
}
