{
  "engine_version": "0.1.0",
  "json_schema": {
    "$defs": {
      "CandlesInput": {
        "additionalProperties": false,
        "description": "Posted candle series (CandleSeries-compatible records).",
        "properties": {
          "candles": {
            "description": "OHLCV records: timestamp/open/high/low/close/volume.",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "minItems": 1,
            "title": "Candles",
            "type": "array"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          },
          "symbol": {
            "minLength": 1,
            "title": "Symbol",
            "type": "string"
          },
          "timeframe": {
            "description": "Timeframe code, e.g. '15m'.",
            "minLength": 1,
            "title": "Timeframe",
            "type": "string"
          },
          "timezone_name": {
            "default": "UTC",
            "description": "Original feed timezone label.",
            "title": "Timezone Name",
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "timeframe",
          "candles"
        ],
        "title": "CandlesInput",
        "type": "object"
      },
      "TradeSetup": {
        "additionalProperties": false,
        "description": "Caller-supplied proposed trade (input to trade evaluation).",
        "properties": {
          "direction": {
            "enum": [
              "long",
              "short"
            ],
            "title": "Direction",
            "type": "string"
          },
          "entry_price": {
            "exclusiveMinimum": 0,
            "title": "Entry Price",
            "type": "number"
          },
          "rationale": {
            "default": "",
            "maxLength": 2000,
            "title": "Rationale",
            "type": "string"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          },
          "stop_loss": {
            "exclusiveMinimum": 0,
            "title": "Stop Loss",
            "type": "number"
          },
          "take_profits": {
            "items": {
              "type": "number"
            },
            "minItems": 1,
            "title": "Take Profits",
            "type": "array"
          }
        },
        "required": [
          "direction",
          "entry_price",
          "stop_loss",
          "take_profits"
        ],
        "title": "TradeSetup",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "AI trade-evaluation request.",
    "properties": {
      "config_overrides": {
        "additionalProperties": true,
        "title": "Config Overrides",
        "type": "object"
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      },
      "series": {
        "$ref": "#/$defs/CandlesInput"
      },
      "setup": {
        "$ref": "#/$defs/TradeSetup"
      }
    },
    "required": [
      "series",
      "setup"
    ],
    "title": "TradeEvaluationRequest",
    "type": "object"
  },
  "name": "TradeEvaluationRequest",
  "schema_version": "1.0.0"
}
