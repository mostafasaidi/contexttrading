{
  "engine_version": "0.1.0",
  "json_schema": {
    "additionalProperties": false,
    "description": "Train/test evaluation of one walk-forward fold.",
    "properties": {
      "best_params": {
        "additionalProperties": true,
        "title": "Best Params",
        "type": "object"
      },
      "fold": {
        "minimum": 1,
        "title": "Fold",
        "type": "integer"
      },
      "overfit": {
        "description": "Test objective degraded beyond the configured threshold vs train.",
        "title": "Overfit",
        "type": "boolean"
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      },
      "test_bars": {
        "minimum": 0,
        "title": "Test Bars",
        "type": "integer"
      },
      "test_net_pnl": {
        "title": "Test Net Pnl",
        "type": "number"
      },
      "test_objective": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "title": "Test Objective"
      },
      "test_trades": {
        "minimum": 0,
        "title": "Test Trades",
        "type": "integer"
      },
      "train_bars": {
        "minimum": 0,
        "title": "Train Bars",
        "type": "integer"
      },
      "train_objective": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "title": "Train Objective"
      }
    },
    "required": [
      "fold",
      "train_bars",
      "test_bars",
      "best_params",
      "train_objective",
      "test_objective",
      "test_net_pnl",
      "test_trades",
      "overfit"
    ],
    "title": "WalkForwardFold",
    "type": "object"
  },
  "name": "WalkForwardFold",
  "schema_version": "1.0.0"
}
