        "type": "string"
      },
      "statistics": {
        "additionalProperties": true,
        "minProperties": 1,
        "title": "Statistics",
        "type": "object"
      },
      "trades": {
        "anyOf": [
          {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Trades"
      }
    },
    "required": [
      "statistics",
      "period"
