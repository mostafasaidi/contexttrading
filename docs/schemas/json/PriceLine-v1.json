{
  "engine_version": "0.1.0",
  "json_schema": {
    "$defs": {
      "LineStyle": {
        "description": "Stroke styles understood by both Plotly and Lightweight Charts.",
        "enum": [
          "solid",
          "dashed",
          "dotted"
        ],
        "title": "LineStyle",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "description": "Horizontal line at a price level (levels, pools, equilibrium).",
    "properties": {
      "color": {
        "description": "Copied from the source object's VisualStyle.",
        "title": "Color",
        "type": "string"
      },
      "layer": {
        "description": "Named layer (grouping/toggling).",
        "minLength": 1,
        "title": "Layer",
        "type": "string"
      },
      "line_style": {
        "$ref": "#/$defs/LineStyle",
        "default": "solid"
      },
      "line_width": {
        "default": 1.0,
        "exclusiveMinimum": 0,
        "title": "Line Width",
        "type": "number"
      },
      "price": {
        "exclusiveMinimum": 0,
        "title": "Price",
        "type": "number"
      },
      "primitive": {
        "const": "price_line",
        "default": "price_line",
        "title": "Primitive",
        "type": "string"
      },
      "priority": {
        "default": 0,
        "description": "In-layer stacking priority.",
        "title": "Priority",
        "type": "integer"
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      },
      "source_id": {
        "description": "ID of the backing AnalysisObject.",
        "minLength": 1,
        "title": "Source Id",
        "type": "string"
      },
      "title": {
        "default": "",
        "description": "Short line title (LW Charts price line).",
        "title": "Title",
        "type": "string"
      },
      "tooltip": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "Structured key/value pairs from the source object (deterministic).",
        "title": "Tooltip",
        "type": "object"
      },
      "z_order": {
        "default": 0,
        "description": "Global stacking order: layer_rank * 100 + priority.",
        "title": "Z Order",
        "type": "integer"
      }
    },
    "required": [
      "source_id",
      "layer",
      "color",
      "price"
    ],
    "title": "PriceLine",
    "type": "object"
  },
  "name": "PriceLine",
  "schema_version": "1.0.0"
}
