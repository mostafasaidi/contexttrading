{
  "engine_version": "0.1.0",
  "json_schema": {
    "$defs": {
      "DataQualityFlags": {
        "additionalProperties": false,
        "description": "Deterministic data-quality assessment of the context inputs.",
        "properties": {
          "flags": {
            "items": {
              "type": "string"
            },
            "title": "Flags",
            "type": "array"
          },
          "level": {
            "enum": [
              "good",
              "fair",
              "poor"
            ],
            "title": "Level",
            "type": "string"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "level"
        ],
        "title": "DataQualityFlags",
        "type": "object"
      },
      "EvidenceEntry": {
        "additionalProperties": false,
        "description": "One citable object: id -> compact digest of engine-computed fields.",
        "properties": {
          "digest": {
            "additionalProperties": true,
            "title": "Digest",
            "type": "object"
          },
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "description": "Object type, e.g. 'swing', 'pool', 'factor'.",
            "minLength": 1,
            "title": "Kind",
            "type": "string"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "title": "EvidenceEntry",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Provided journal/performance statistics wrapped for interpretation.",
    "properties": {
      "data_quality": {
        "$ref": "#/$defs/DataQualityFlags"
      },
      "evidence_index": {
        "additionalProperties": {
          "$ref": "#/$defs/EvidenceEntry"
        },
        "title": "Evidence Index",
        "type": "object"
      },
      "kind": {
        "enum": [
          "journal",
          "performance"
        ],
        "title": "Kind",
        "type": "string"
      },
      "period": {
        "default": "",
        "title": "Period",
        "type": "string"
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      },
      "statistics": {
        "additionalProperties": true,
        "title": "Statistics",
        "type": "object"
      },
      "trades": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "title": "Trades",
        "type": "array"
      }
    },
    "required": [
      "kind",
      "data_quality"
    ],
    "title": "JournalContext",
    "type": "object"
  },
  "name": "JournalContext",
  "schema_version": "1.0.0"
}
