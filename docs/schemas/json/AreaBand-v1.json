{
  "engine_version": "0.1.0",
  "json_schema": {
    "additionalProperties": false,
    "description": "Full-height time-range shading (sessions, killzones).",
    "properties": {
      "color": {
        "description": "Copied from the source object's VisualStyle.",
        "title": "Color",
        "type": "string"
      },
      "end_time": {
        "minimum": 0,
        "title": "End Time",
        "type": "integer"
      },
      "layer": {
        "description": "Named layer (grouping/toggling).",
        "minLength": 1,
        "title": "Layer",
        "type": "string"
      },
      "opacity": {
        "default": 0.1,
        "maximum": 1,
        "minimum": 0,
        "title": "Opacity",
        "type": "number"
      },
      "primitive": {
        "const": "area_band",
        "default": "area_band",
        "title": "Primitive",
        "type": "string"
      },
      "priority": {
        "default": 0,
        "description": "In-layer stacking priority.",
        "title": "Priority",
        "type": "integer"
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      },
      "source_id": {
        "description": "ID of the backing AnalysisObject.",
        "minLength": 1,
        "title": "Source Id",
        "type": "string"
      },
      "start_time": {
        "minimum": 0,
        "title": "Start Time",
        "type": "integer"
      },
      "tooltip": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "Structured key/value pairs from the source object (deterministic).",
        "title": "Tooltip",
        "type": "object"
      },
      "z_order": {
        "default": 0,
        "description": "Global stacking order: layer_rank * 100 + priority.",
        "title": "Z Order",
        "type": "integer"
      }
    },
    "required": [
      "source_id",
      "layer",
      "color",
      "start_time",
      "end_time"
    ],
    "title": "AreaBand",
    "type": "object"
  },
  "name": "AreaBand",
  "schema_version": "1.0.0"
}
