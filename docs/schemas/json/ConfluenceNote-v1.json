{
  "engine_version": "0.1.0",
  "json_schema": {
    "$defs": {
      "EvidenceStatement": {
        "additionalProperties": false,
        "description": "A constrained text claim with its supporting engine-object ids.",
        "properties": {
          "evidence_ids": {
            "description": "Ids into the context evidence_index backing this claim.",
            "items": {
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          },
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "EvidenceStatement",
        "type": "object"
      },
      "TrendDirection": {
        "description": "Directional state of price, a candle, or a structure leg.",
        "enum": [
          "bullish",
          "bearish",
          "ranging",
          "unknown"
        ],
        "title": "TrendDirection",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "description": "One confluence observation, bound to confluence-engine factor ids.",
    "properties": {
      "description": {
        "$ref": "#/$defs/EvidenceStatement"
      },
      "direction": {
        "$ref": "#/$defs/TrendDirection"
      },
      "factor_ids": {
        "description": "'factor:NN:name' keys from the context.",
        "items": {
          "type": "string"
        },
        "title": "Factor Ids",
        "type": "array"
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      },
      "zone_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "ConfluenceZone id when the note is zone-based.",
        "title": "Zone Id"
      }
    },
    "required": [
      "description",
      "direction"
    ],
    "title": "ConfluenceNote",
    "type": "object"
  },
  "name": "ConfluenceNote",
  "schema_version": "1.0.0"
}
