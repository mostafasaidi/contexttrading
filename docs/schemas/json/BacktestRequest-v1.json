{
  "engine_version": "0.1.0",
  "json_schema": {
    "$defs": {
      "CandlesInput": {
        "additionalProperties": false,
        "description": "Posted candle series (CandleSeries-compatible records).",
        "properties": {
          "candles": {
            "description": "OHLCV records: timestamp/open/high/low/close/volume.",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "minItems": 1,
            "title": "Candles",
            "type": "array"
          },
          "schema_version": {
            "default": "1.0.0",
            "description": "Version of this model's schema ('major.minor.patch').",
            "title": "Schema Version",
            "type": "string"
          },
          "symbol": {
            "minLength": 1,
            "title": "Symbol",
            "type": "string"
          },
          "timeframe": {
            "description": "Timeframe code, e.g. '15m'.",
            "minLength": 1,
            "title": "Timeframe",
            "type": "string"
          },
          "timezone_name": {
            "default": "UTC",
            "description": "Original feed timezone label.",
            "title": "Timezone Name",
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "timeframe",
          "candles"
        ],
        "title": "CandlesInput",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Backtest request: candles + strategy + config overrides.",
    "properties": {
      "backtest_overrides": {
        "additionalProperties": true,
        "title": "Backtest Overrides",
        "type": "object"
      },
      "engine_overrides": {
        "additionalProperties": true,
        "title": "Engine Overrides",
        "type": "object"
      },
      "mtf_timeframes": {
        "items": {
          "type": "string"
        },
        "title": "Mtf Timeframes",
        "type": "array"
      },
      "schema_version": {
        "default": "1.0.0",
        "description": "Version of this model's schema ('major.minor.patch').",
        "title": "Schema Version",
        "type": "string"
      },
      "series": {
        "$ref": "#/$defs/CandlesInput"
      },
      "strategy": {
        "default": "smc_pullback",
        "description": "Registered strategy name (see routes/backtest).",
        "title": "Strategy",
        "type": "string"
      },
      "strategy_params": {
        "additionalProperties": true,
        "title": "Strategy Params",
        "type": "object"
      }
    },
    "required": [
      "series"
    ],
    "title": "BacktestRequest",
    "type": "object"
  },
  "name": "BacktestRequest",
  "schema_version": "1.0.0"
}
